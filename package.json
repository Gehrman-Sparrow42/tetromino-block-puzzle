{
  "name": "tetromino-block-puzzle",
  "private": true,
  "version": "2.13.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:clean": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "format": "prettier --write src index.html *.ts *.json tests scripts/*.cjs scripts/*.yml README.md",
    "online:typecheck": "tsc --noEmit -p tsconfig.online.json",
    "online:build": "npm run online:typecheck && vite build --config vite.online.config.ts",
    "online:server": "npm run online:build && node dist-online/main.js",
    "online:lan": "npm run build && npm run online:server",
    "online:start": "node dist-online/main.js",
    "online:test:browser": "playwright test --config playwright.online.config.ts",
    "online:test": "vitest run --config vitest.online.config.ts",
    "rewards:build": "npm run online:typecheck && vite build --config vite.rewards.config.ts",
    "rewards:server": "npm run rewards:build && node dist-rewards/main.js",
    "rewards:test": "vitest run --config vitest.online.config.ts server/rewards src/platform/rewarded-ads.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.0"
  }
}
